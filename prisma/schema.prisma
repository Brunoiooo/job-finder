generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Source {
  USEME
}

model Job {
  id        BigInt   @id @default(autoincrement())
  url       String   @unique
  summary   String
  offer     String?
  source    Source
  sent      Boolean  @default(false)
  ignored   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

model UsemeCategories {
  id  BigInt @id @default(autoincrement())
  url String @unique
}

model Prompt {
  id        BigInt   @id @default(autoincrement())
  source    Source
  content   String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@unique([id, source])
}
